// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "LLM Tooling",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// uv provides uvx, which runs stdio MCP servers.
	"features": {
		"ghcr.io/va-h/devcontainers-features/uv:1": {}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.live-server",
				"github.copilot-chat",
				"anthropic.claude-code",
				"dnut.rewrap-revived"
			],
			"settings": {
				"dev.containers.copyGitConfig": true,
				"[markdown]": {
					"editor.rulers": [
						120
					]
				},
				"editor.formatOnSave": true,
				"workbench.colorCustomizations": {
					"titleBar.activeBackground": "#6B4C9A",
					"titleBar.activeForeground": "#FFFFFF",
					"titleBar.inactiveBackground": "#56407A",
					"titleBar.inactiveForeground": "#FFFFFFCC",
					"activityBar.background": "#7A5BAA",
					"activityBar.foreground": "#FFFFFF",
					"activityBar.inactiveForeground": "#FFFFFF99",
					"statusBar.background": "#6B4C9A",
					"statusBar.foreground": "#FFFFFF",
					"statusBarItem.remoteBackground": "#56407A",
					"statusBarItem.remoteForeground": "#FFFFFF"
				},
				"workbench.trustedDomains": [
					"https://claude.ai"
				]
			}
		}
	},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
	"remoteEnv": {
		"CLAUDE_CONFIG_DIR": "/workspaces/.claude"
	},
	// Runs once, at container creation. The only lifecycle hook.
	"postCreateCommand": "./.devcontainer/post-create.sh"
}